{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "templating": {
    "list": [
      {
        "allValue": "navalstrike-metrics|navalstrike-apilocal",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(http_server_requests_seconds_count, job)",
        "includeAll": true,
        "label": "Ambiente",
        "multi": true,
        "name": "job",
        "query": "label_values(http_server_requests_seconds_count, job)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "title": "Requisições por Segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Latência P95 por Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"$job\", uri!=\"/actuator/prometheus\"}[5m])) by (le, uri))",
          "legendFormat": "P95 {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Latência P99 por Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"$job\", uri!=\"/actuator/prometheus\"}[5m])) by (le, uri))",
          "legendFormat": "P99 {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Taxa de Erros (4xx e 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\", status=~\"5..\"}[1m])) by (uri, status)",
          "legendFormat": "5xx {{status}} {{uri}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\", status=~\"4..\", uri!=\"UNKNOWN\"}[1m])) by (uri, status)",
          "legendFormat": "4xx {{status}} {{uri}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Latência Média por Endpoint",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=~\"$job\", uri!=\"/actuator/prometheus\", uri!=\"UNKNOWN\"}[5m])) by (method, uri) / sum(rate(http_server_requests_seconds_count{job=~\"$job\", uri!=\"/actuator/prometheus\", uri!=\"UNKNOWN\"}[5m])) by (method, uri)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "title": "Hibernate - Queries Executadas/s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(hibernate_query_execution_total{job=~\"$job\"}[1m])",
          "legendFormat": "Queries",
          "refId": "A"
        },
        {
          "expr": "rate(hibernate_entities_loads_total{job=~\"$job\"}[1m])",
          "legendFormat": "Entity Loads",
          "refId": "B"
        },
        {
          "expr": "rate(hibernate_statements_total{job=~\"$job\"}[1m])",
          "legendFormat": "Statements",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Hibernate - Tempo Máximo de Query (ms)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hibernate_query_execution_max_seconds{job=~\"$job\"} * 1000",
          "legendFormat": "Max Query Time",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "HikariCP - Conexões",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\"$job\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=~\"$job\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{job=~\"$job\"}",
          "legendFormat": "Pending",
          "refId": "C"
        }
      ]
    },
    {
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"}",
          "legendFormat": "Used {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{job=~\"$job\", area=\"heap\"}",
          "legendFormat": "Max {{id}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM Threads",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\"$job\"}",
          "legendFormat": "Live Threads",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "GC Pauses",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[1m])",
          "legendFormat": "{{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Jaeger - Traces",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "queryType": "search",
          "service": "navalstrikeAPI",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      }
    }
  ],
